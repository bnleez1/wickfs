pkgname=gdrive
pkgver=0.1.0
pkgrel=1
pkgdesc='Smart on-demand Google Drive virtual filesystem and LFU/LRU disk cache'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'fuse3' 'xdg-desktop-portal')
optdepends=('rclone: Google Drive OAuth and remote synchronization')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/gdrive "$pkgdir/usr/bin/gdrive"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/gdrive.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/gdrive.svg"
  install -Dm644 "$startdir/gdrive.desktop" "$pkgdir/usr/share/applications/gdrive.desktop"
  install -Dm644 "$startdir/gdrive.service" "$pkgdir/usr/lib/systemd/user/gdrive.service"
}
