[Unit]
Description=WickFS Smart Cache FUSE3 Daemon & Standby Wake Sync
After=network-online.target dbus.socket graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/wickfs daemon
Restart=always
RestartSec=3

[Install]
WantedBy=default.target graphical-session.target
